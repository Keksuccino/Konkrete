{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "environment": "*",
  "authors": [
    "${mod_authors}"
  ],
  "contributors": [
  ],
  "contact": {},
  "license": "${mod_license}",
  "icon": "${mod_id}_logo_128x128.png",
  "entrypoints": {
    "main": [
      "de.keksuccino.konkrete.KonkreteFabric"
    ],
    "client": [
      "de.keksuccino.konkrete.KonkreteFabricClient"
    ],
    "server": []
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "accessWidener": "${mod_id}.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_short_version}",
    "melody": ">=${melody_version}",
    "minecraft": ">=${minecraft_version}",
    "java": ">=${java_version}"
  },
  "suggests": {
    "fancy_entity_renderer": ">=${fer_version}",
    "rinku": ">=${rinku_version}",
    "watermedia": ">=${watermedia_version}",
    "watermedia_binaries": ">=${watermedia_binaries_version}"
  },
  "breaks": {
    "drippyloadingscreen": "<3.0.1",
    "fancymenu": "<3.1.0",
    "watermedia": "<${watermedia_version}",
    "watermedia_binaries": "<${watermedia_binaries_version}"
  },
  "custom": {
    "modmenu": {
      "badges": [ "library" ]
    }
  }
}
